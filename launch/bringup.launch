<launch>
    <!-- Manual terminal 1 (pixi run bringup), real robot and simulation alike.
         driver: airbot_py (airbot_server over gRPC, default), sim (pixi run sim),
                 module:Class (another ArmDriver), or can (the C++ CAN node, formerly use_grpc:=false). -->
    <arg name="driver" default="airbot_py" />
    <arg name="env_type" default="real" />
    <arg name="url" default="localhost" />
    <arg name="port" default="50051" />
    <arg name="use_rviz" default="true" />
    <!-- only for driver:=can -->
    <arg name="urdf" default="/usr/share/airbot_models/airbot_play_with_gripper.urdf" />
    <arg name="interface" default="can0" />
    <arg name="end_mode" default="gripper" />
    <arg name="forearm_type" default="DM" />
    <arg name="use_planning" default="true" />
    <arg name="use_joy" default="false" />
    <arg name="is_can" value="$(eval driver == 'can')" />

    <!-- pick-place, keyboard and vision pick configs/<group>/<env_type>.yaml -->
    <param name="/env_type" value="$(arg env_type)" />

    <node if="$(arg is_can)" name="airbot_arm_ros" pkg="ros_interface" type="airbot_arm_ros" output="screen">
        <param name="urdf" value="$(arg urdf)" />
        <param name="interface" value="$(arg interface)" />
        <param name="end_mode" value="$(arg end_mode)" />
        <param name="forearm_type" value="$(arg forearm_type)" />
        <param name="use_planning" value="$(arg use_planning)" />
    </node>
    <node unless="$(arg is_can)" name="airbot_arm_ros" pkg="airbot_play_follow_basic" type="airbot_play_ros_interface.py" output="screen" required="true">
        <!-- the repository root, so that driver modules such as sim.driver can be imported -->
        <env name="PYTHONPATH" value="$(dirname)/..:$(optenv PYTHONPATH)" />
        <param name="driver" value="$(arg driver)" />
        <param name="url" value="$(arg url)" />
        <param name="port" value="$(arg port)" />
    </node>
    <include file="$(find airbot_play_launch)/airbot_play_moveit.launch">
        <arg name="target_moveit_config" value="airbot_play_v3_gripper_gazebo_all_config" />
        <arg name="use_basic" value="true" />
        <arg name="use_rviz"  value="$(arg use_rviz)" />
        <arg unless="$(arg is_can)" name="arm_cmd_topic" value="/airbot_play/joint_cmd" />
        <arg if="$(arg is_can)" name="arm_cmd_topic" value="/airbot_play/set_target_joint_q" />
        <arg name="frequency" value="200" />
        <arg name="use_gripper" value="false" />
    </include>
</launch>
